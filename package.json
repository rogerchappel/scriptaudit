{
  "name": "scriptaudit",
  "version": "0.1.0",
  "description": "Local-first CLI that audits package scripts and command docs into deterministic safety maps.",
  "type": "module",
  "bin": {
    "scriptaudit": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "smoke": "bash scripts/smoke.sh",
    "package:smoke": "npm pack --dry-run",
    "release:workflow-check": "node scripts/check-release-workflows.mjs",
    "release:check": "npm test && npm run check && npm run build && npm run smoke && npm run package:smoke && npm run release:workflow-check"
  },
  "keywords": [
    "cli",
    "package-scripts",
    "safety",
    "audit",
    "agents"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/scriptaudit.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/scriptaudit/issues"
  },
  "homepage": "https://github.com/rogerchappel/scriptaudit#readme"
}
